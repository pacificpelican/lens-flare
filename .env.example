# Server config
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Public app URL (used for password reset links, etc.)
# Should match where users access the app from
APP_URL=http://localhost:5173

# JWT secrets (generate with: openssl rand -hex 32)
JWT_SECRET=your-jwt-secret-here-please-change-in-production
REFRESH_TOKEN_SECRET=your-refresh-token-secret-here-please-change-in-production

# Database config - SQLite (default)
DATABASE_TYPE=sqlite
SQLITE_PATH=lens-flare.db

# Database config - MySQL (uncomment to use MySQL instead)
# DATABASE_TYPE=mysql
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=password
# MYSQL_DATABASE=lens_flare

# AI Configuration
AI_ENABLED=true
AI_PROVIDER=ollama
# AI_PROVIDER options: ollama, openai, anthropic, none

# Ollama configuration
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llava:latest

# OpenAI configuration (if using OpenAI)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4-vision

# Anthropic configuration (if using Anthropic)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-vision

# Registration Configuration
# Allow open signups (true = anyone can register, false = invite code required)
ALLOW_OPEN_SIGNUPS=true

# Comma-separated list of invite codes (only used if ALLOW_OPEN_SIGNUPS=false)
# Example: INVITE_CODES=macaw,cockatoo,parakeet
# Empty = no invite codes work (locked down)
INVITE_CODES=

# Email Configuration
# Supported providers: mailgun, smtp, none
# Set to 'none' to disable password reset and email features entirely
# In development without credentials, emails are logged to console (dry-run mode)
EMAIL_PROVIDER=mailgun
EMAIL_FROM=noreply@lens-flare.local

# Mailgun configuration (SMTP)
MAILGUN_SMTP_HOST=smtp.mailgun.org
MAILGUN_SMTP_PORT=587
MAILGUN_SMTP_SECURE=false
MAILGUN_SMTP_USER=your-mailgun-email@sandboxXXX.mailgun.org
MAILGUN_SMTP_PASS=your-mailgun-password

# Alternative SMTP configuration (if not using Mailgun)
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Disable email entirely (no password reset feature)
# EMAIL_PROVIDER=none

